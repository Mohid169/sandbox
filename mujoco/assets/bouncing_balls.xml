<mujoco model="bouncing-ball">
  <option timestep="0.0002" gravity="0 0 -9.81"/>
  <visual>
    <map znear="0.001" zfar="50"/>
  </visual>

  <!-- Global defaults: frictionless contacts -->
  <default>
    <geom friction="0 0 0" condim="3"/>
    <!-- Contact impedance: very stiff, ~zero damping via negative (stiffness, damping) form -->
    <!-- MILDLY BOUNCY -->
    <pair solref="-5000 -0.0" solimp="0.9 0.99 0.0001"/>
    <!-- VERY BOUNCY (uncomment to try) -->
    <!-- <pair solref="-15000 -0.0" solimp="0.95 0.995 0.00005"/> -->
  </default>

  <worldbody>
    <!-- Floor -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" rgba="0.9 0.9 0.9 1"/>

    <!-- Ball (free body) -->
    <body name="ball" pos="0 0 1.5">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.1" density="1000" rgba="0.2 0.5 1 1"/>
    </body>
  </worldbody>

  <!-- Explicit contact pair so our solref/solimp apply -->
  <contact>
    <pair geom1="ball_geom" geom2="floor" solref="-5000 -0.0" solimp="0.9 0.99 0.0001"/>
    <!-- Or use the VERY BOUNCY values here -->
    <!-- <pair geom1="ball_geom" geom2="floor" solref="-15000 -0.0" solimp="0.95 0.995 0.00005"/> -->
  </contact>
</mujoco>



