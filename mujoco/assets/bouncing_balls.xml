<mujoco model="bounce_elastic_long">
  <!-- Tiny dt + RK4 to minimize numerical dissipation -->
  <option timestep="0.0001" gravity="0 0 -9.81" integrator="RK4"/>
  <compiler angle="radian" coordinate="local"/>

  <default>
    <!-- No hidden joint losses -->
    <joint damping="0" armature="0"/>

    <!-- Purely normal contact (no tangential DOFs), zero friction -->
    <!-- solref=[time_const, damping_ratio]   solimp=[a b width] -->
    <geom
      condim="1"
      friction="0 0 0"
      solref="0.025 0.00"
      solimp="0.997 0.9995 0.0002"
    />
  </default>

  <worldbody>
    <!-- Use a box floor, not an infinite plane (often a bit more forgiving) -->
    <body name="floor" pos="0 0 0">
      <geom name="floor_box" type="box" size="5 5 0.05" pos="0 0 -0.05" rgba="0.12 0.12 0.12 1"/>
    </body>

    <!-- Larger, denser ball = bigger time/energy scales => less sensitive -->
    <body name="ball" pos="0 0 2.0">
      <freejoint/>
      <geom type="sphere" size="0.10" density="1500" rgba="0.2 0.6 1 1"/>
    </body>
  </worldbody>
</mujoco>



